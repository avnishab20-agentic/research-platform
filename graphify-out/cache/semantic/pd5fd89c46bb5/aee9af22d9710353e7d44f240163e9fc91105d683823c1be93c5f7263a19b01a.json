{"nodes": [{"id": "docs_story_90_method_reference_method_reference", "label": "Method reference (CB/CO/SE/FM table)", "file_type": "document", "source_file": "docs/story/90-method-reference.md", "source_location": "90-method-reference.md:1-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every non-trivial method with called-by, calls-out, side effects and failure modes. Record accessors, the three identical mains and the Python health one-liner are skipped as trivial."}, {"id": "docs_story_90_method_reference_yaml_binding_npe_at_request_time", "label": "YAML key mismatch binds null and fails at request time", "file_type": "rationale", "source_file": "docs/story/90-method-reference.md", "source_location": "90-method-reference.md:47-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tier4: vs tier4Patterns mismatch binds null and only blows up in the pattern loop when a request arrives - there is no boot-time validation. This was Session 4's real bug."}, {"id": "docs_story_90_method_reference_urlnormalizer_blind_spots", "label": "UrlNormalizer documented blind spots", "file_type": "rationale", "source_file": "docs/story/90-method-reference.md", "source_location": "90-method-reference.md:55-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ports are dropped because getPort is never read, and a percent-encoded & inside a parameter value would split wrongly because getQuery decodes before the split. Documented, not handled; non-hierarchical URIs like mailto: would NPE."}], "edges": [{"source": "docs_story_90_method_reference_method_reference", "target": "docs_story_00_the_world_searchservice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/90-method-reference.md", "source_location": "90-method-reference.md:24-31", "weight": 1.0}, {"source": "docs_story_90_method_reference_m