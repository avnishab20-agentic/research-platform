{"nodes": [{"id": "docs_story_05_boot_and_compose_two_ignition_switches", "label": "Two ignition switches (compose up, then the Java apps)", "file_type": "concept", "source_file": "docs/story/05-boot-and-compose.md", "source_location": "05-boot-and-compose.md:27-95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five sealed boxes run on the machine, plus up to three Java programs standing outside them phoning in through published ports; the Java services are deliberately absent from docker-compose."}, {"id": "docs_story_05_boot_and_compose_docker_layer_caching", "label": "Docker layer caching and shared base layers", "file_type": "concept", "source_file": "docs/story/05-boot-and-compose.md", "source_location": "05-boot-and-compose.md:170-200", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each Dockerfile line produces a cached layer re-run only if its input changed; two images from the same base share those layers on disk instead of each keeping a private copy. EXPOSE is documentation only - the port mapping plus --host 0.0.0.0 are what make the port reachable."}, {"id": "docs_story_05_boot_and_compose_eager_vs_lazy_connection", "label": "Eager vs lazy connection at boot", "file_type": "rationale", "source_file": "docs/story/05-boot-and-compose.md", "source_location": "05-boot-and-compose.md:96-140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "control-plane connects to Postgres eagerly and runs Flyway, so a dead database fails boot; retrieval-service reaches Redis lazily through Lettuce, so a dead Redis boots fine and fails the request instead."}], "edges": [{"source": "docs_story_05_boot_and_compose_two_ignition_switches", "target": "docs_story_00_the_world_docker_compose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/05-boot-and-compose.md", "source_location": "05-boo