{"nodes": [{"id": "docs_story_03_extract_stub_flow_contract_first_stub", "label": "Contract-first stubbing", "file_type": "rationale", "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:150-185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stub nails the promise cheaply: callers can integrate today, routing and JSON round-tripping are proven by the real machinery, and the real body later grows underneath without the contract moving. Session 4 stubbed all three endpoints; two have since grown real bodies, this one has been open for five sessions."}, {"id": "docs_story_03_extract_stub_flow_wired_but_never_called", "label": "Wired but never called", "file_type": "concept", "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:186-230", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ExtractorClient is a Spring bean alive in memory on every run with a van, an address and a route, and nobody ever hands him a parcel. ExtractCacheKey.of() is called only from its own test."}, {"id": "docs_story_03_extract_stub_flow_field_names_are_the_contract", "label": "Record field names ARE the public contract", "file_type": "rationale", "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:430-448", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming urls to pageUrls fails silently: Jackson finds no matching field, leaves it null, and nobody notices until the real body silently processes an empty list on every request. The compiler will happily let you do it."}, {"id": "docs_story_03_extract_stub_flow_200kb_cap", "label": "200KB document cap (planned)", "file_type": "rationale", "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:458-470", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One giant document does not just waste space - under allkeys-lru it actively evicts useful neighbours. Caps protect the cache's whole ecosystem, not just its memory ceiling."}, {"id": "docs_story_03_extract_stub_flow_seven_day_ttl", "label": "7-day extract TTL vs 24h search TTL", "file_type": "rationale", "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:280-296", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search results get 24 hours because news moves; an extracted article body is far more stable, so its note can sit for seven days."}, {"id": "docs_story_03_extract_stub_flow_semaphore_four", "label": "Semaphore(4) in front of the sidecar (planned)", "file_type": "concept", "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:298-306", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four permits cap in-flight extractions so a dozen simultaneous researchers cannot flatten the little Python service, which has no queue or limit of its own."}], "edges": [{"source": "docs_story_03_extract_stub_flow_contract_first_stub", "target": "docs_story_00_the_world_retrievalcontroller", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:150-185", "weight": 1.0}, {"source": "docs_story_03_extract_stub_flow_wired_but_never_called", "target": "docs_story_00_the_world_extractorclient", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/03-extract-stub-flow.md", "source_location": "03-extract-stub-flow.md:200-230", "weight": 1.0}, {"source": "docs_story_03_extract_stub_flow_wired_but_never_called", "target": "docs_story_00_the_world_extractcachekey", "relation": "refe