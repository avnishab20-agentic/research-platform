{"nodes": [{"id": "docs_story_02_quota_flow_date_in_key_reset", "label": "Date-in-the-key daily reset (midnight is an illusion)", "file_type": "rationale", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:295-320", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No @Scheduled job exists anywhere. At 00:01 the code simply builds a different key that nothing was ever stored under, Redis returns null, and the null branch reads it as 0 spent. Yesterday's counter is orphaned, not reset. Midnight is the JVM's default time zone."}, {"id": "docs_story_02_quota_flow_ttl_is_the_cleaner", "label": "The TTL is the cleaner, not the reset", "file_type": "rationale", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:310-318", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXPIRE exists only so orphaned counters do not pile up in memory; it re-arms on every spend, so a busy day's counter cannot expire out from under you mid-afternoon."}, {"id": "docs_story_02_quota_flow_incr_atomicity", "label": "INCR atomicity and implicit zero", "file_type": "concept", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:270-292", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INCR treats a missing key as 0 so the first search of the day needs no create-if-absent branch, and its read-add-write cannot be split, so six simultaneous searches land on 6 rather than 1."}, {"id": "docs_story_02_quota_flow_store_spent_not_remaining", "label": "Store spent, not remaining", "file_type": "rationale", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:440-458", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because the stored value counts up rather than down, raising daily-limit instantly shows more credits left without touching a single stored entry."}, {"id": "docs_story_02_quota_flow_reading_never_writes", "label": "Reading the gauge never burns fuel", "file_type": "rationale", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:320-336", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "remaining() stores nothing, and recordSpend() is called from exactly one place - the cache-miss branch - so the second identical search costs zero credits."}, {"id": "docs_story_02_quota_flow_fail_loud_on_corrupt_counter", "label": "Crash loudly on a corrupt counter", "file_type": "rationale", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:420-432", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapping the parse in a silent try/catch that returns 0 would quietly report full credits while over-spending; a NumberFormatException and a 500 is arguably the better behaviour."}, {"id": "docs_story_02_quota_flow_global_not_per_user", "label": "The quota is global, not per user", "file_type": "rationale", "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:392-400", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The key is built from the date and nothing else because authentication is cut from weeks 1-4; per-user counting arrives in Week 5 keyed off the logged-in user."}], "edges": [{"source": "docs_story_02_quota_flow_date_in_key_reset", "target": "docs_story_00_the_world_quotaservice", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:295-320", "weight": 1.0}, {"source": "docs_story_02_quota_flow_ttl_is_the_cleaner", "target": "docs_story_02_quota_flow_date_in_key_reset", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:310-318", "weight": 1.0}, {"source": "docs_story_02_quota_flow_incr_atomicity", "target": "docs_story_00_the_world_redis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:270-292", "weight": 1.0}, {"source": "docs_story_02_quota_flow_store_spent_not_remaining", "target": "docs_story_00_the_world_quotaservice", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:440-458", "weight": 1.0}, {"source": "docs_story_02_quota_flow_reading_never_writes", "target": "docs_story_01_search_flow_cache_aside", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:320-336", "weight": 1.0}, {"source": "docs_story_02_quota_flow_fail_loud_on_corrupt_counter", "target": "docs_story_01_search_flow_no_error_handling", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:420-432", "weight": 1.0}, {"source": "docs_story_02_quota_flow_global_not_per_user", "target": "docs_story_00_the_world_quota_fuel_gauge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:392-400", "weight": 1.0}, {"source": "docs_story_02_quota_flow_incr_atomicity", "target": "docs_story_01_search_flow_cache_stampede", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/story/02-quota-flow.md", "source_location": "02-quota-flow.md:284-292", "weight": 1.0}], "hyperedges": []}