<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.comeback.researchplatform</groupId>
    <artifactId>research-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>common</module>
        <module>retrieval-service</module>
        <module>agent-service</module>
        <module>control-plane</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <!-- SonarQube Cloud project. These are the names SonarQube Cloud gives a GitHub
             import by default; if its project page shows different ones, change them here. -->
        <sonar.organization>avnishab20-agentic</sonar.organization>
        <sonar.projectKey>avnishab20-agentic_research-platform</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>4.1.0</version>
                    <!-- No spring-boot-starter-parent here, so repackage must be bound explicitly or package yields a thin, non-runnable jar. -->
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Pinned here so `mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar`
                     in CI always uses this version. Only CI runs it. -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>5.8.0.7211</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Test coverage. prepare-agent watches which lines the tests run;
                 report turns that into target/site/jacoco/jacoco.xml (read by
                 SonarQube Cloud) and index.html (open it in a browser).
                 Declared here, not per module, so every module gets it. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
