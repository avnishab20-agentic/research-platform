# Copy to .env (gitignored) and fill in. docker compose reads .env automatically;
# for mvn spring-boot:run, export these in your shell instead.

# DeepSeek chat model, used by agent-service and control-plane.
DEEPSEEK_API_KEY=

# Optional. Only needed if the Tavily search provider is switched on.
TAVILY_API_KEY=

# SearXNG signing key. Generate with: openssl rand -hex 32
SEARXNG_SECRET=

# control-plane token signing key (HS256, needs >= 32 bytes). Generate with: openssl rand -base64 32
JWT_SECRET=

# Google / GitHub login. Create OAuth clients whose callback is
# <site>/login/oauth2/code/google and <site>/login/oauth2/code/github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
